# Copy to .env.local for local testing. Configure production values in Vercel.
# Server-only: never place these values in React, HTML, or public/.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Random server secret used to hash account/network allowance keys.
FITMACRO_USAGE_SALT=
# RevenueCat API v1 key from the SAME project as the iOS/Android apps.
REVENUECAT_API_KEY=
# Base Web Purchase Link, e.g. https://pay.rev.cat/<token>.
# Do not include a customer ID or query parameters. Sandbox links require the flag below.
REVENUECAT_PURCHASE_LINK=
# Set true to test sandbox checkout on your existing domain; false for live billing.
REVENUECAT_ALLOW_SANDBOX=false
